# --- App ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-random-string

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Enable "Google Drive API" for the project first.
# Authorized redirect URI must be: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok OAuth (developers.tiktok.com > Manage apps) ---
# Add the "Content Posting API" product to your app.
# Redirect URI must be: {BASE_URL}/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
